NODE_ENV=development
PORT=5000

# MongoDB (local — runs in Docker)
MONGO_URI=mongodb://localhost:27017/clm

# Redis (local — runs in Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-real-secret
JWT_REFRESH_SECRET=change-me-to-a-real-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / S3 (local — runs in Docker)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clm-contracts
S3_REGION=us-east-1

# Frontend
VITE_API_URL=http://localhost:5000
