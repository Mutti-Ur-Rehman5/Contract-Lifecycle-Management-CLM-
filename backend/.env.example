NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://mongo:27017/clm

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-real-secret
JWT_REFRESH_SECRET=change-me-to-a-real-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clm-contracts
S3_REGION=us-east-1

# Frontend
VITE_API_URL=http://localhost:5000
